# ===================================================
# Production Backend Environment Variables (Render)
# ===================================================
ENV=production

# 1. Neon.tech or Supabase connection string (auto-normalized to postgresql+psycopg://)
# Example: postgresql://neondb_owner:npg_xyz@ep-cold-shadow-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# 2. Vercel Frontend URL(s) for CORS (comma-separated, or wildcard *.vercel.app is handled automatically)
CORS_ORIGINS=https://your-frontend-app.vercel.app

# 3. Security & Cookies
SESSION_SECRET_KEY=change-this-to-a-very-long-random-string-in-production-ai-risk-2026
COOKIE_SECURE=true
COOKIE_SAMESITE=none
DEV_AUTO_LOGIN=false

# 4. Hugging Face / Qwen LLM Configuration
# Model: https://huggingface.co/Qwen/Qwen3-Next-80B-A3B-Instruct
# Get a free access token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_access_token_here
LLM_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
LLM_BASE_URL=https://router.huggingface.co/v1
